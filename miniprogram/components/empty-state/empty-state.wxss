.empty-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  padding: 48rpx 36rpx;
  border: 1rpx solid rgba(23, 26, 23, 0.12);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.52);
}

.empty-state__mark {
  width: 56rpx;
  height: 8rpx;
  background: #171a17;
}

.empty-state__title {
  color: #171a17;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-state__message {
  color: #6c6f6b;
  font-size: 26rpx;
}

