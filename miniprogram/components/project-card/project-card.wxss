.project-card {
  overflow: hidden;
  border: 1rpx solid rgba(23, 26, 23, 0.12);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
}

.project-card:active {
  opacity: 0.78;
}

.project-card__cover {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #242821;
}

.project-card__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f6f4ee;
  font-size: 24rpx;
  font-weight: 700;
}

.project-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.project-card__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
}

.project-card__meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #8a6c2f;
  font-size: 22rpx;
  font-weight: 600;
}

.project-card__title {
  color: #171a17;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.project-card__summary {
  color: #4b504a;
  font-size: 26rpx;
}

.project-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

