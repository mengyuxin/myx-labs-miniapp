.detail-page {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.detail-cover {
  overflow: hidden;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 8rpx;
  background: #242821;
}

.detail-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f6f4ee;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-cover__image {
  display: block;
  width: 100%;
  height: 100%;
}

.detail-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-header__category {
  color: #8a6c2f;
  font-size: 23rpx;
  font-weight: 700;
}

.detail-header__title {
  color: #171a17;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.12;
}

.detail-header__summary {
  color: #4b504a;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-section,
.detail-info {
  padding: 32rpx;
  border: 1rpx solid rgba(23, 26, 23, 0.12);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.56);
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-section__title {
  color: #171a17;
  font-size: 26rpx;
  font-weight: 700;
}

.detail-section__body {
  color: #4b504a;
  font-size: 28rpx;
}

.detail-info {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.detail-info__row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  color: #4b504a;
  font-size: 25rpx;
}

.copy-button,
.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 30rpx;
  border-radius: 8rpx;
  background: #171a17;
  color: #f6f4ee;
  font-size: 28rpx;
  font-weight: 700;
}

.copy-button {
  justify-content: space-between;
}

.not-found {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

