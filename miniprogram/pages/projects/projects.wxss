.projects-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 68rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(23, 26, 23, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
  color: #4b504a;
  font-size: 25rpx;
  font-weight: 600;
}

.category-chip--active {
  background: #171a17;
  color: #f6f4ee;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

