.home-page {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-height: 520rpx;
  padding: 52rpx 36rpx;
  border: 1rpx solid rgba(23, 26, 23, 0.14);
  border-radius: 8rpx;
  background: #171a17;
  color: #f6f4ee;
}

.hero__label {
  color: #d6b35f;
  font-size: 22rpx;
  font-weight: 600;
}

.hero__title {
  margin-top: auto;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
}

.hero__copy {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.25;
}

.hero__description {
  color: rgba(246, 244, 238, 0.76);
  font-size: 27rpx;
}

.home-section {
  display: flex;
  flex-direction: column;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.explore-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 30rpx;
  border: 1rpx solid rgba(23, 26, 23, 0.22);
  border-radius: 8rpx;
  background: #d6b35f;
  color: #171a17;
  font-size: 28rpx;
  font-weight: 700;
}

