<view class="page about-page">
  <section-header
    label="About"
    title="{{profile.name}}"
    subtitle="{{profile.tagline}}"
  />

  <view class="about-panel">
    <text class="about-panel__body">{{profile.description}}</text>
    <text class="about-panel__body">
      这里记录从好奇心出发、最终变成可用网页或工具的公开实验。MVP 小程序保持原生、轻量、静态内容驱动。
    </text>
  </view>

  <view class="about-list">
    <view class="about-list__row">
      <text>Content</text>
      <text>Public Projects</text>
    </view>
    <view class="about-list__row">
      <text>Built with</text>
      <text>WeChat Mini Program</text>
    </view>
    <view class="about-list__row">
      <text>Version</text>
      <text>{{profile.version}}</text>
    </view>
  </view>

  <button wx:if="{{hasWebsite}}" class="website-button" bindtap="onCopyWebsite">
    <text>Copy Public Website</text>
    <text>↗</text>
  </button>
</view>

