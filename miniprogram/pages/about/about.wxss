.about-page {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.about-panel,
.about-list {
  border: 1rpx solid rgba(23, 26, 23, 0.12);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.56);
}

.about-panel {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 34rpx;
}

.about-panel__body {
  color: #4b504a;
  font-size: 28rpx;
}

.about-list {
  display: flex;
  flex-direction: column;
  padding: 8rpx 30rpx;
}

.about-list__row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(23, 26, 23, 0.1);
  color: #4b504a;
  font-size: 25rpx;
}

.about-list__row:last-child {
  border-bottom: 0;
}

.website-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 30rpx;
  border-radius: 8rpx;
  background: #171a17;
  color: #f6f4ee;
  font-size: 28rpx;
  font-weight: 700;
}

